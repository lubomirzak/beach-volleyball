rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'lubomir.zak@gmail.com';
    }
    match /seasonMatches/{document} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.seasonId == 'winter-2026';
      allow delete: if isAdmin() && resource.data.seasonId == 'winter-2026';
    }
    match /seasonTrainings/{document} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.seasonId == 'winter-2026';
    }
    match /seasonFines/{document} {
      allow read: if isAdmin() || resource.data.seasonId == 'winter-2026';
      allow create: if isAdmin()
        && request.resource.data.seasonId == 'winter-2026';
    }

    match /players/{document} {
      allow read: if true;
      allow create: if isAdmin();
    }
  }
}
